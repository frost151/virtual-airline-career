[
  {
    "id": "fenix-a32x",
    "name": "Fenix A319/A320/A321",
    "match": ["fenix"],
    "types": [
      { "match": "a319", "type": "A319" },
      { "match": "a321", "type": "A321" },
      { "match": "a320", "type": "A320" }
    ],
    "defaultType": "A320",
    "lights": "lvars",
    "lvars": {
      "beacon": { "name": "L:S_OH_EXT_LT_BEACON", "onIfAtLeast": 1 },
      "strobe": { "name": "L:S_OH_EXT_LT_STROBE", "onIfAtLeast": 1 },
      "landing": { "name": "L:S_OH_EXT_LT_LANDING_L", "onIfAtLeast": 2 },
      "nav": { "name": "L:S_OH_EXT_LT_NAV_LOGO", "onIfAtLeast": 1 },
      "taxi": { "name": "L:S_OH_EXT_LT_NOSE", "onIfAtLeast": 1 }
    },
    "verified": false,
    "notes": "Имена L-переменных и положения переключателей не проверены на MSFS 2024"
  },
